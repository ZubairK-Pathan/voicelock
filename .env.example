# VoiceLock Enterprise — Environment Configuration Template
# Copy this file to .env and supply actual values for local development.
# NEVER commit .env or private credentials to version control.

# Server Configuration
ENV=development
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=info

# Biometric & Model Settings
SPEECHBRAIN_DEVICE=cpu
DEFAULT_THRESHOLD=0.25
MAX_AUDIO_SIZE_BYTES=10485760  # 10 MB upload ceiling
CHALLENGE_TIMEOUT_SECONDS=60
CHALLENGE_LENGTH=3

# Database (PostgreSQL / SQLite)
POSTGRES_USER=voicelock_user
POSTGRES_PASSWORD=voicelock_secure_password
POSTGRES_DB=voicelock_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://voicelock_user:voicelock_secure_password@localhost:5432/voicelock_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Firebase Authentication (Server-Side ID Token Verification)
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id

# IoT & Device Authentication
DEVICE_AUTH_SECRET=generate-a-secure-random-secret-for-device-hmac
