# VoiceLock Enterprise — Frontend Environment Configuration
# Copy this file to .env.local for local development.
# NEVER commit real credentials or .env.local to Git.

# Firebase Web App Configuration (from Firebase Console > Project Settings > General > Web Apps)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=voice-lock-7c111.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=voice-lock-7c111
VITE_FIREBASE_STORAGE_BUCKET=voice-lock-7c111.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_web_app_id

# VoiceLock FastAPI Backend API URL
VITE_API_BASE_URL=http://localhost:8000
